# Sideout ingress (sideout.cc). On the shared VPS these blocks live in the
# UnserPlan Caddyfile at /srv/caddy/Caddyfile.
# No `encode` here: the app gzips its own responses (tower-http, which
# correctly exempts text/event-stream). Caddy's encoder buffers SSE streams
# while sniffing compressibility, so EventSource would never receive headers.

sideout.cc {
	reverse_proxy sideout-live:8080
}

www.sideout.cc {
	redir https://sideout.cc{uri} permanent
}

test.sideout.cc {
	reverse_proxy sideout-test:8080
}
